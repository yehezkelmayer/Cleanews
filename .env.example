# Supabase / PostgreSQL connection string.
# Use the connection pooler URL from Supabase (Session mode is fine).
DATABASE_URL=postgres://postgres:password@db.host.supabase.co:6543/postgres?sslmode=require

# Secret used to authenticate the /api/cron/fetch-news endpoint.
# Send as Authorization: Bearer <CRON_SECRET> or ?secret=<CRON_SECRET>.
CRON_SECRET=change-me-to-a-long-random-string

# Optional: threshold for topic matching (default 0.3, range 0-1).
# TOPIC_MATCH_THRESHOLD=0.3
